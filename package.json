{
  "name": "floatpng",
  "productName": "FloatPNG",
  "version": "1.0.0",
  "description": "Deixa PNGs a flutuar em qualquer sítio do ecrã e arrasta-os à vontade.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "PYTHON_PATH=/usr/bin/python3 electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "PYTHON_PATH=/usr/bin/python3 electron-builder --mac --win"
  },
  "build": {
    "appId": "com.ricardojanz.floatpng",
    "productName": "FloatPNG",
    "files": ["src/**/*", "package.json"],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
